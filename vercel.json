{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": "{nextstep_prompt/**,server.py,evals/**}"
      }
    },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/web/index.html" },
    { "src": "/(.+)", "dest": "/web/$1" }
  ],
  "env": {
    "GEMINI_MODEL": "gemini-flash-lite-latest"
  }
}
